# From https://my.telegram.org — a user API application, not a bot token.
API_ID=
API_HASH=

# Telethon StringSession file. This is a credential. Never commit it.
TELEGRAM_SESSION_PATH=secrets/telegram.session

# Optional. On Railway, paste the one-line session here instead of uploading a file.
# The worker writes it to TELEGRAM_SESSION_PATH when that file is absent.
# TELEGRAM_SESSION_STRING=

# The worker never prompts. Use `python -m vinnytsia_monitor.auth` locally.
# Set true only when you want the worker itself to prompt in a local terminal.
INTERACTIVE_AUTH=false

CONFIG_DIR=config
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_MESSAGE_TEXT=false
